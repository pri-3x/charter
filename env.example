# Postgres (docker compose defaults)
DATABASE_URL=postgres://charter_gate:gatepass@localhost:5433/charter
VERIFIER_DATABASE_URL=postgres://charter_verifier:verifypass@localhost:5433/charter
POSTGRES_SUPERUSER_URL=postgres://postgres:postgres@localhost:5433/charter

# Gate
PORT=8080
CHARTER_ADMIN_KEY=change-me-admin-key
CHARTER_SIGNING_KEY_PATH=./keys/signing.pem        # Ed25519 private (gen script writes it)
CHARTER_SIGNING_PUB_PATH=./keys/signing.pub.pem
ANCHORS_LOG_PATH=./anchors.log
CHECKPOINT_INTERVAL_MS=300000
CHECKPOINT_MAX_BATCH=1000

# Approvals (create a bot via @BotFather; add it to a group; put the chat id on the tenant row)
TELEGRAM_BOT_TOKEN=

# Demo agent
ANTHROPIC_API_KEY=

# Local console bootstrap (loopback + non-production only). Leave unset in any shared deployment.
CHARTER_DEV_CONSOLE=true

# Agent the credential-free public demo endpoints (/v1/demo/*) act as. Unset ⇒ those endpoints
# answer 503 and the landing page falls back to its recording, which is the honest default: the
# page never holds a credential, so without this the server has nothing to decide with. The key
# rotates on every db:reset — re-read it from .seed/agent-key.json afterwards.
CHARTER_DEMO_AGENT_KEY=

# ===== Pattern B: credential custody =====
# AES-256 key (base64, 32 bytes) sealing tool secrets in tool_credentials. Unset ⇒ /v1/credentials
# and /v1/proxy answer 503 and Pattern A still works; it is never defaulted or generated, because a
# gate that invents a key at boot encrypts happily and cannot decrypt anything after a restart.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CHARTER_CREDENTIAL_KEY=

# Dev only (ignored under NODE_ENV=production): permit http://localhost egress targets so a tool
# stub can run on this machine. Loopback and private ranges are refused otherwise — a gate that
# will POST your payment key to 169.254.169.254 is a metadata-exfiltration primitive.
CHARTER_ALLOW_LOOPBACK_EGRESS=false
