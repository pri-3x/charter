# Postgres (docker compose defaults)
DATABASE_URL=postgres://charter_gate:gatepass@localhost:5433/charter
VERIFIER_DATABASE_URL=postgres://charter_verifier:verifypass@localhost:5433/charter
POSTGRES_SUPERUSER_URL=postgres://postgres:postgres@localhost:5433/charter

# Gate
PORT=8080
CHARTER_ADMIN_KEY=change-me-admin-key
CHARTER_SIGNING_KEY_PATH=./keys/signing.pem        # Ed25519 private (gen script writes it)
CHARTER_SIGNING_PUB_PATH=./keys/signing.pub.pem
ANCHORS_LOG_PATH=./anchors.log
CHECKPOINT_INTERVAL_MS=300000
CHECKPOINT_MAX_BATCH=1000

# Approvals (create a bot via @BotFather; add it to a group; put the chat id on the tenant row)
TELEGRAM_BOT_TOKEN=

# Demo agent
ANTHROPIC_API_KEY=

# Local console bootstrap (loopback + non-production only). Leave unset in any shared deployment.
CHARTER_DEV_CONSOLE=true
